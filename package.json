    "render:cocacola40": "PATH=\"/usr/bin:/bin:/usr/local/bin\" RENDER_WORKFLOW=render-cocacola40.yml /usr/bin/node scripts/render-preflight.mjs && RENDER_WORKFLOW=render-cocacola40.yml /usr/bin/node scripts/trigger-github-render.mjs",
    "render:obsidian30": "PATH=\"/usr/bin:/bin:/usr/local/bin\" RENDER_WORKFLOW=render-obsidian30.yml /usr/bin/node scripts/render-preflight.mjs && RENDER_WORKFLOW=render-obsidian30.yml /usr/bin/node scripts/trigger-github-render.mjs",
    "render:borrowedlight38": "PATH=\"/usr/bin:/bin:/usr/local/bin\" RENDER_WORKFLOW=render-borrowedlight38.yml /usr/bin/node scripts/render-preflight.mjs && RENDER_WORKFLOW=render-borrowedlight38.yml /usr/bin/node scripts/trigger-github-render.mjs",
    "render:originalspot": "PATH=\"/usr/bin:/bin:/usr/local/bin\" RENDER_WORKFLOW=render-originalspot.yml /usr/bin/node scripts/render-preflight.mjs && RENDER_WORKFLOW=render-originalspot.yml /usr/bin/node scripts/trigger-github-render.mjs",
    "assemble:originalspot": "bash compositions/OriginalSpot/assemble-originalspot.sh",
    "render:ace-435-local": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/render-ace-435-local-all.mjs",
