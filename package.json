    "sync:public-render": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/sync-public-render-repo.mjs",
    "sync:public-render:push": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/sync-public-render-repo.mjs --push",
    "assemble:ace435": "bash scripts/assemble-ace435-downloaded.sh",
    "assemble:video434": "bash scripts/assemble-video434-downloaded.sh",
    "assemble:chrysalis30": "bash scripts/assemble-chrysalis30-downloaded.sh",
    "assemble:cocacola40": "bash scripts/assemble-cocacola40-downloaded.sh",
    "assemble:obsidian30": "bash scripts/assemble-obsidian30-downloaded.sh",
    "assemble:borrowedlight38": "bash scripts/assemble-borrowedlight38-downloaded.sh",
