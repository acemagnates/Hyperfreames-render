{
  "name": "hyperfreames",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/npx --yes hyperframes@0.5.5 preview",
    "check": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/hf-check.mjs",
    "project:prepare": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/prepare-primary-project.mjs",
    "render:preflight": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/render-preflight.mjs",
    "render": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/render-preflight.mjs && /usr/bin/node scripts/trigger-github-render.mjs",
    "render:dispatch": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/render-preflight.mjs && RENDER_NO_WAIT=1 /usr/bin/node scripts/trigger-github-render.mjs",
    "render:ace-435-local": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/render-ace-435-local-all.mjs",
    "render:local": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/npx --yes hyperframes@0.5.5 render .",
    "sync:public-render": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/sync-public-render-repo.mjs",
    "sync:public-render:push": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/sync-public-render-repo.mjs --push",
    "taste-check": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/taste-check.mjs",
    "engine:lint": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/engine-lint/run.mjs --profile auto",
    "engine:pacing": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/evaluate-cinematic-pacing.mjs",
    "engine:skeleton": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/generate-clip-skeleton.mjs",
    "motion-engine:preflight": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/motion-engine-preflight.mjs",
    "sfx:plan": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node tools/sfx-mcp/src/cli.mjs plan",
    "sfx:validate": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node tools/sfx-mcp/src/cli.mjs validate",
    "sfx:mix-spec": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/node scripts/sfx-mix-from-manifest.mjs",
    "publish": "PATH=\"/usr/bin:/bin:/usr/local/bin\" /usr/bin/npx --yes hyperframes@0.5.5 publish",
    "render:blackwed": "PATH=\"/usr/bin:/bin:/usr/local/bin\" RENDER_WORKFLOW=render-blackwed.yml /usr/bin/node scripts/render-preflight.mjs && RENDER_WORKFLOW=render-blackwed.yml /usr/bin/node scripts/trigger-github-render.mjs",
    "assemble:blackwed": "bash compositions/BlackWed/assemble-blackwed.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "parse5": "^7.2.1"
  }
}
